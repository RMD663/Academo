<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#172038"
    android:padding="24dp"
    tools:context=".GameActivity">

    <TextView
        android:id="@+id/game_level_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="LEVEL 1"
        android:textColor="#a4a9b3"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />


    <TextView
        android:id="@+id/question_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Loading question..."
        android:textColor="#ebede9"
        android:textSize="24sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />


    <!-- Multiple Choice   -->

    <LinearLayout
        android:id="@+id/container_multiple_choice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <Button android:id="@+id/btn_option_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Option A" android:backgroundTint="#212B46" android:textColor="#ebede9"/>
        <Button android:id="@+id/btn_option_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Option B" android:backgroundTint="#212B46" android:textColor="#ebede9"/>
        <Button android:id="@+id/btn_option_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Option C" android:backgroundTint="#212B46" android:textColor="#ebede9"/>
        <Button android:id="@+id/btn_option_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Option D" android:backgroundTint="#212B46" android:textColor="#ebede9"/>
    </LinearLayout>

    <!-- True or False -->

    <LinearLayout
        android:id="@+id/container_true_false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="TRUE"
            android:backgroundTint="#468232"
            android:textColor="#ebede9" />

        <Button
            android:id="@+id/btn_false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FALSE"
            android:backgroundTint="#962A2A"
            android:textColor="#ebede9" />
    </LinearLayout>


    <!-- Written  -->

    <LinearLayout
        android:id="@+id/container_text_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/input_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Type your answer here..."
            android:textColorHint="#5A6786"
            android:textColor="#ebede9"
            android:backgroundTint="#ebede9"
            android:inputType="textCapSentences"
            android:layout_marginBottom="12dp"
            tools:ignore="Autofill" />

        <Button
            android:id="@+id/btn_submit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONFIRM ANSWER"
            android:backgroundTint="#468232"
            android:textColor="#ebede9"/>
    </LinearLayout>

</LinearLayout>